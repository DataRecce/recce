{
  "name": "recce",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=26.5.0"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build && cp -R out/. ../recce/data/ && rm -rf out",
    "start": "next start",
    "lint": "biome check --diagnostic-level=error",
    "lint:fix": "biome check --write --diagnostic-level=error",
    "lint:staged": "biome check --staged --diagnostic-level=error",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:dist": "vitest run --config vitest.dist.config.mts",
    "type:check": "pnpm type:check:root && pnpm --filter @datarecce/ui type:check && pnpm --filter @datarecce/storybook type:check",
    "type:check:root": "tsc --noEmit",
    "clean": "rimraf ../recce/data",
    "prepare": "cd .. && husky js/.husky"
  },
  "dependencies": {
    "@amplitude/unified": "1.1.32",
    "@babel/helpers": "^8.0.5",
    "@babel/runtime": "^8.0.5",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@dagrejs/dagre": "3.1.0",
    "@datarecce/ui": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/montserrat": "^5.3.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@jeromefitz/date-fns-tz": "3.0.0-canary.8",
    "@mui/material": "^9.4.0",
    "@mui/system": "^9.4.0",
    "@next/third-parties": "16.3.5",
    "@sentry/nextjs": "^10.74.0",
    "@sentry/react": "^10.74.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "5.102.8",
    "@types/js-cookie": "^3.0.6",
    "@uiw/codemirror-theme-github": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@xyflow/react": "^12.11.6",
    "@zumer/snapdom": "^2.24.15",
    "ag-grid-community": "^36.1.0",
    "ag-grid-react": "^36.1.0",
    "chart.js": "^4.5.1",
    "codemirror": "^6.0.2",
    "common-tags": "^1.8.2",
    "date-fns": "^4.4.0",
    "file-saver": "^2.0.5",
    "happy-dom": "^20.14.5",
    "import-in-the-middle": "^3.5.1",
    "js-cookie": "^3.0.8",
    "lodash": "^4.18.1",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.433.3",
    "react": "19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-split": "^2.0.14",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "require-in-the-middle": "^8.0.1",
    "simplebar": "^6.3.3",
    "simplebar-react": "3.3.2",
    "usehooks-ts": "^3.1.1",
    "write-excel-file": "^4.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@amplitude/analytics-core": "^2.55.0",
    "@biomejs/biome": "2.5.13",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/common-tags": "^1.8.4",
    "@types/file-saver": "^2.0.7",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "baseline-browser-mapping": "^2.11.23",
    "fast-check": "^4.10.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.28",
    "read-excel-file": "^9.3.10",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
